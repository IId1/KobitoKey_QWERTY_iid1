#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * レイヤー構成:
 *   0: DEFAULT    (基本レイヤー)
 *   1: TB_OFF     (トラックボール自動検知OFFフラグ用・全透過 / 12+13 または 16+17 でトグル)
 *   2: WM_ON      (Wrist Mouse 常時カーソルONフラグ用・全透過 / 22+23 または 26+27 でトグル)
 *   3: NUMBER     (36 長押し)
 *   4: FUNCTION   (33 長押し)
 *   5: MOUSE      (32 または 37 長押し — トグル状態に関わらずトラボ＋Wrist Mouse 両方有効)
 *   6: SYMBOL     (39 長押し)
 *   7: SCROLL     (MOUSE / AUTO_MOUSE 中に 31 または 38 を 0.3秒以上長押し — トラボ・Wrist Mouse 両方縦横ホイール)
 *   8: AUTO_MOUSE (左右トラックボール移動時の自動マウスレイヤー)
 */

/ {
    behaviors {
        /* 0.3秒(300ms)以上の長押しで上下左右ホイール操作レイヤー(Layer 7)を有効化、短押しは無効(0) */
        lt_scroll: layer_tap_scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
        };

        /* 指定レイヤーを明示的にOFFにするビヘイビア */
        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        /* トラックボール動作（オートマウス＋カーソル移動）の ON/OFF トグル（発動中の AUTO_MOUSE も即座に解除） */
        tb_toggle: tb_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &tog 1 &tog_off 8>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };

        /*
         * 12+13 (D+F) または 16+17 (J+K) 同時押し:
         * 左右トラックボールのポインティング動作（オートマウス＋カーソル移動）ON/OFF トグル
         * ※ トラボに触れた直後（AUTO_MOUSE Layer 8 滞留中 5秒間）でも確実に切り替えられるよう 8 も対象に含め、
         *   NUMBER(3) / FUNCTION(4) / 手動MOUSE(5) / SYMBOL(6) / SCROLL(7) では誤爆しないように制限
         */
        combo_tb_toggle_l {
            timeout-ms = <50>;
            key-positions = <12 13>;
            layers = <0 1 2 8>;
            bindings = <&tb_toggle>;
        };

        combo_tb_toggle_r {
            timeout-ms = <50>;
            key-positions = <16 17>;
            layers = <0 1 2 8>;
            bindings = <&tb_toggle>;
        };

        /*
         * 22+23 (C+V) または 26+27 (M+,) 同時押し:
         * Wrist Mouse 常時カーソル移動 ON/OFF トグル（どちらの状態でも 32/37 長押し時は反応）
         */
        combo_wm_toggle_l {
            timeout-ms = <50>;
            key-positions = <22 23>;
            layers = <0 1 2 8>;
            bindings = <&tog 2>;
        };

        combo_wm_toggle_r {
            timeout-ms = <50>;
            key-positions = <26 27>;
            layers = <0 1 2 8>;
            bindings = <&tog 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: DEFAULT */
        default_layer {
            bindings = <
&kp Q      &kp W     &kp E        &kp R        &kp T      &kp Y     &kp U        &kp I        &kp O      &kp P
&kp A      &kp S     &kp D        &kp F        &kp G      &kp H     &kp J        &kp K        &kp L      &kp SEMI
&kp Z      &kp X     &kp C        &kp V        &kp B      &kp N     &kp M        &kp COMMA    &kp DOT    &kp APOS
&kp LSHFT  &kp LGUI  &lt 5 LANG2  &lt 4 SPACE  &kp LCTRL  &kp BSPC  &lt 3 ENTER  &lt 5 LANG1  &kp MINUS  &lt 6 SLASH
            >;
        };

        /* Layer 1: トラックボール自動検知無効化フラグ用透過レイヤー (12+13 / 16+17 でトグル) */
        layer1 {
            label = "TB_OFF";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Layer 2: Wrist Mouse 常時カーソル有効化フラグ用透過レイヤー (22+23 / 26+27 でトグル) */
        layer2 {
            label = "WM_ON";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Layer 3: NUMBER (36長押し) */
        layer3 {
            label = "NUMBER";
            bindings = <
&kp N0     &kp N1  &kp N2  &kp N3     &trans  &kp MINUS  &trans     &kp UP    &trans     &trans
&kp EQUAL  &kp N4  &kp N5  &kp N6     &trans  &kp PLUS   &kp LEFT   &kp DOWN  &kp RIGHT  &trans
&trans     &kp N7  &kp N8  &kp N9     &trans  &kp ASTRK  &kp SLASH  &kp LBKT  &kp RBKT   &trans
&trans     &trans  &trans  &kp LSHFT  &trans  &trans     &trans     &trans    &trans     &trans
            >;
        };

        /* Layer 4: FUNCTION (33長押し) */
        layer4 {
            label = "FUNCTION";
            bindings = <
&trans   &kp F1   &kp F2   &kp F3  &trans    &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans   &kp F4   &kp F5   &kp F6  &trans    &bt BT_CLR      &trans        &trans        &trans        &trans
&kp F10  &kp F7   &kp F8   &kp F9  &trans    &bt BT_CLR_ALL  &trans        &trans        &trans        &trans
&trans   &kp F11  &kp F12  &trans  &trans    &kp DEL         &trans        &trans        &trans        &trans
            >;
        };

        /* Layer 5: MOUSE (32または37長押し: トグル状態に関わらず wrist_mouse ＋ 左右トラボのすべてが有効) */
        layer5 {
            label = "MOUSE";
            bindings = <
&trans     &mkp MB4          &trans       &mkp MB5           &trans  &trans  &mkp MB4          &trans       &mkp MB5           &trans
&trans     &mkp MB2          &mkp MB3     &mkp MB1           &trans  &trans  &mkp MB1          &mkp MB3     &mkp MB2           &trans
&kp LCTRL  &kp LG(LC(LEFT))  &kp LG(TAB)  &kp LG(LC(RIGHT))  &trans  &trans  &kp LG(LC(LEFT))  &kp LG(TAB)  &kp LG(LC(RIGHT))  &kp RCTRL
&kp LSHFT  &lt_scroll 7 0    &trans       &trans             &trans  &trans  &trans            &trans       &lt_scroll 7 0     &kp RSHFT
            >;
        };

        /* Layer 6: SYMBOL (39長押し) */
        layer6 {
            label = "SYMBOL";
            bindings = <
&kp EXCL   &kp AT     &kp HASH   &kp DLLR  &kp PRCNT  &trans  &trans  &trans  &trans  &trans
&kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR   &trans  &trans  &trans  &trans  &trans
&kp GRAVE  &kp TILDE  &kp LBRC   &kp RBRC  &kp PIPE   &trans  &trans  &trans  &trans  &trans
&trans     &kp UNDER  &kp MINUS  &kp PLUS  &kp BSLH   &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Layer 7: SCROLL (31または38を0.3秒以上長押し) */
        layer7 {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Layer 8: AUTO_MOUSE (左右トラックボール操作時のオートマウス専用レイヤー) */
        layer8 {
            label = "AUTO_MOUSE";
            bindings = <
&trans     &mkp MB4          &trans       &mkp MB5           &trans  &trans  &mkp MB4          &trans       &mkp MB5           &trans
&trans     &mkp MB2          &mkp MB3     &mkp MB1           &trans  &trans  &mkp MB1          &mkp MB3     &mkp MB2           &trans
&kp LCTRL  &kp LG(LC(LEFT))  &kp LG(TAB)  &kp LG(LC(RIGHT))  &trans  &trans  &kp LG(LC(LEFT))  &kp LG(TAB)  &kp LG(LC(RIGHT))  &kp RCTRL
&kp LSHFT  &lt_scroll 7 0    &trans       &trans             &trans  &trans  &trans            &trans       &lt_scroll 7 0     &kp RSHFT
            >;
        };
    };
};
