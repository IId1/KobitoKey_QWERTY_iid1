#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        /* 0.3秒(300ms)以上の長押しで上下左右ホイール操作レイヤー(Layer 5)を有効化、短押しは無効(0) */
        lt_scroll: layer_tap_scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
        };

        /* 指定レイヤーを明示的にOFFにするビヘイビア */
        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        /* オートマウスレイヤーの ON/OFF トグル（現在発動中の Layer 6 も即座に解除） */
        aml_toggle: aml_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &tog 7 &tog_off 6>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };

        /* 11+12+13 (S+D+F) または 15+16+17 (H+J+K) 同時押し: オートマウスレイヤー ON/OFF トグル */
        combo_aml_toggle_l {
            timeout-ms = <60>;
            key-positions = <11 12 13>;
            bindings = <&aml_toggle>;
        };

        combo_aml_toggle_r {
            timeout-ms = <60>;
            key-positions = <15 16 17>;
            bindings = <&aml_toggle>;
        };

        /* 21+22+23 (X+C+V) または 25+26+27 (N+M+,) 同時押し: Wrist Mouse カーソル移動 ON/OFF トグル */
        combo_wm_toggle_l {
            timeout-ms = <60>;
            key-positions = <21 22 23>;
            bindings = <&tog 8>;
        };

        combo_wm_toggle_r {
            timeout-ms = <60>;
            key-positions = <25 26 27>;
            bindings = <&tog 8>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W     &kp E        &kp R        &kp T      &kp Y     &kp U        &kp I        &kp O      &kp P
&kp A      &kp S     &kp D        &kp F        &kp G      &kp H     &kp J        &kp K        &kp L      &kp SEMI
&kp Z      &kp X     &kp C        &kp V        &kp B      &kp N     &kp M        &kp COMMA    &kp DOT    &kp APOS
&kp LSHFT  &kp LGUI  &lt 3 LANG2  &lt 2 SPACE  &kp LCTRL  &kp BSPC  &lt 1 ENTER  &lt 3 LANG1  &kp MINUS  &lt 4 SLASH
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp N0     &kp N1  &kp N2  &kp N3     &trans  &kp MINUS  &trans     &kp UP    &trans     &trans
&kp EQUAL  &kp N4  &kp N5  &kp N6     &trans  &kp PLUS   &kp LEFT   &kp DOWN  &kp RIGHT  &trans
&trans     &kp N7  &kp N8  &kp N9     &trans  &kp ASTRK  &kp SLASH  &kp LBKT  &kp RBKT   &trans
&trans     &trans  &trans  &kp LSHFT  &trans  &trans     &trans     &trans    &trans     &trans
            >;
        };

        layer2 {
            label = "FUNCTION";
            bindings = <
&trans   &kp F1   &kp F2   &kp F3  &trans    &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans   &kp F4   &kp F5   &kp F6  &trans    &bt BT_CLR      &trans        &trans        &trans        &trans
&kp F10  &kp F7   &kp F8   &kp F9  &trans    &bt BT_CLR_ALL  &trans        &trans        &trans        &trans
&trans   &kp F11  &kp F12  &trans  &trans    &kp DEL         &trans        &trans        &trans        &trans
            >;
        };

        /* 32または37の長押し時: wrist_mouse（トグル状態に関わらず有効）＋ 左右トラボのすべてが有効 */
        layer3 {
            label = "MOUSE";
            bindings = <
&trans     &mkp MB4         &trans    &mkp MB5  &trans  &trans  &mkp MB4  &trans    &mkp MB5         &trans
&trans     &mkp MB2         &mkp MB3  &mkp MB1  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2         &trans
&kp LCTRL  &trans           &trans    &trans    &trans  &trans  &trans    &trans    &trans           &kp RCTRL
&kp LSHFT  &lt_scroll 5 0   &trans    &trans    &trans  &trans  &trans    &trans    &lt_scroll 5 0   &kp RSHFT
            >;
        };

        layer4 {
            label = "SYMBOL";
            bindings = <
&kp EXCL   &kp AT     &kp HASH   &kp DLLR  &kp PRCNT  &trans  &trans  &trans  &trans  &trans
&kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR   &trans  &trans  &trans  &trans  &trans
&kp GRAVE  &kp TILDE  &kp LBRC   &kp RBRC  &kp PIPE   &trans  &trans  &trans  &trans  &trans
&trans     &kp UNDER  &kp MINUS  &kp PLUS  &kp BSLH   &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer5 {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* 左右トラックボール操作時のオートマウス専用レイヤー */
        layer6 {
            label = "AUTO_MOUSE";
            bindings = <
&trans     &mkp MB4         &trans    &mkp MB5  &trans  &trans  &mkp MB4  &trans    &mkp MB5         &trans
&trans     &mkp MB2         &mkp MB3  &mkp MB1  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2         &trans
&kp LCTRL  &trans           &trans    &trans    &trans  &trans  &trans    &trans    &trans           &kp RCTRL
&kp LSHFT  &lt_scroll 5 0   &trans    &trans    &trans  &trans  &trans    &trans    &lt_scroll 5 0   &kp RSHFT
            >;
        };

        /* Layer 7: オートマウス無効化フラグ用透過レイヤー (11+12+13 / 15+16+17 でトグル) */
        layer7 {
            label = "AML_OFF";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Layer 8: Wrist Mouse 常時カーソル有効化フラグ用透過レイヤー (21+22+23 / 25+26+27 でトグル) */
        layer8 {
            label = "WM_ON";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
